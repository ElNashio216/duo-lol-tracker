# Copiá este archivo como .env y completá con tus valores reales. # IMPORTANTE: nunca subas el archivo .env real (con tokens reales) a este # repo, ya que es público. En Portainer, estas variables se cargan # directamente en el campo de "Environment variables" del stack, no # necesitás un archivo .env en el servidor. DISCORD_TOKEN=tu_token_del_bot_de_discord RIOT_API_KEY=tu_riot_api_key CHANNEL_ID=id_del_canal_de_discord_donde_postear
